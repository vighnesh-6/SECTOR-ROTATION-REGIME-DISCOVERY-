# ==============================================================================
# SECTOR ROTATION REGIME DISCOVERY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Security Notice: NEVER commit actual credentials or secrets to version control.
# Copy this file to .env.local for local testing or populate in GitHub Secrets / Vercel.

# --- Neon PostgreSQL Database Configuration (Required) ---
DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-calm-rain-a1emw9d9-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<PASSWORD>@ep-calm-rain-a1emw9d9.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=rapid-rain-44826778
NEON_ORG_ID=org-muddy-violet-93189980
NEON_REGION_ID=aws-ap-southeast-1

# --- Primary Market Data Provider: Yahoo Finance (yfinance) ---
# Active provider: Yahoo Finance (yfinance). Zero credentials or API keys required.
# Ingests daily completed EOD candles for the 8 canonical index series:
# NIFTY 50 (^NSEI), NIFTY BANK (^NSEBANK), NIFTY AUTO (^CNXAUTO),
# NIFTY FMCG (^CNXFMCG), NIFTY IT (^CNXIT), NIFTY METAL (^CNXMETAL),
# NIFTY PHARMA (^CNXPHARMA), INDIA VIX (^INDIAVIX).
MARKET_DATA_PROVIDER=yfinance

# --- Pipeline Execution & Retry Schedule ---
# Primary daily EOD fetch scheduled at 7:00 PM IST (13:30 UTC)
PIPELINE_EXECUTION_TIME_IST=19:00
PIPELINE_RETRY_SCHEDULE_IST="19:00, 19:30, 20:00, 20:30"
PIPELINE_MAX_RETRIES=4
PIPELINE_RETRY_DELAY_SECONDS=2.0
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID_OR_EMPTY

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME="Indian Equity Sector Rotation Regime Intelligence"

